# Only runtime source, the pinned Linux locks, and the built plugin enter the context.
**
!Dockerfile
!pyserver/
!pyserver/app/
!pyserver/app/**
!pyserver/run.py
!pyserver/locks/
!pyserver/locks/linux-x86_64-cp311.txt
!pyserver/locks/linux-aarch64-cp311.txt
!plugin/
!plugin/Risu.Hina.Plugin.js
**/__pycache__/
**/*.pyc
